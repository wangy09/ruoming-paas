# ================================================================
# 若茗 PaaS - 环境变量模板
# Author: ruoming
# 说明：复制此文件为 .env.development / .env.production，填写真实值
#       .env.development 和 .env.production 已加入 .gitignore
# ================================================================

# ── 环境 ────────────────────────────────────────────────────────
APP_ENV=development                 # development / test / production
DEBUG=true                          # 生产环境请改为 false

# ── 数据库（必填）────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://ruoming:ruoming123@localhost:5432/ruoming_dev
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ── Redis（必填）──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── 安全（必填）──────────────────────────────────────────────────
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=your-super-secret-key-at-least-32-chars-long
ENCRYPT_KEY=                        # 留空则自动派生（仅开发用）

# JWT 配置
ACCESS_TOKEN_EXPIRE_MINUTES=15      # 生产建议 15 分钟
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── 登录安全 ──────────────────────────────────────────────────────
LOGIN_FAIL_MAX_TIMES=5
LOGIN_LOCK_MINUTES=30

# ── CORS ──────────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── AI 配置 ───────────────────────────────────────────────────────
AI_DEFAULT_PROVIDER=openai          # openai / zhuilu / ollama
AI_DEFAULT_MODEL=gpt-3.5-turbo

# 追鹿 API（主力大模型）
ZHUILU_API_KEY=your-zhuilu-api-key
ZHUILU_BASE_URL=https://api.zhuilu.ai/v1
ZHUILU_DEFAULT_MODEL=deepseek-chat

# OpenAI（备用）
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama（本地，开发用）
OLLAMA_BASE_URL=http://localhost:11434

# ── 向量数据库 ───────────────────────────────────────────────────
VECTOR_STORE_TYPE=pgvector          # MVP 阶段用 pgvector
VECTOR_DIMENSION=1536
EMBEDDING_MODEL=text-embedding-3-small

# ── 文件存储 ──────────────────────────────────────────────────────
STORAGE_BACKEND=local               # local / oss / minio
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# 阿里云 OSS（生产环境）
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY=
OSS_SECRET_KEY=
OSS_CDN_DOMAIN=

# ── 日志 ──────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_JSON=false                      # 生产环境改为 true
