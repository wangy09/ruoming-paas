# ================================================================
# 若茗 PaaS - 生产环境变量模板
# 使用：cp deploy/.env.production.example deploy/.env.production
# 注意：deploy/.env.production 不要提交到 Git
# ================================================================

# ── Compose / 镜像 ───────────────────────────────────────────────
APP_VERSION=local

# ── PostgreSQL ──────────────────────────────────────────────────
POSTGRES_USER=ruoming
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_DB=ruoming_prod

# ── Redis ───────────────────────────────────────────────────────
REDIS_PASSWORD=change-this-redis-password

# ── 后端运行环境 ─────────────────────────────────────────────────
APP_ENV=production
DEBUG=false
LOG_JSON=true
LOG_LEVEL=INFO

# 注意：这里的主机名使用 docker-compose.prod.yml 内部服务名
DATABASE_URL=postgresql+asyncpg://ruoming:change-this-postgres-password@postgres:5432/ruoming_prod
REDIS_URL=redis://:change-this-redis-password@redis:6379/0
CELERY_BROKER_URL=redis://:change-this-redis-password@redis:6379/1
CELERY_RESULT_BACKEND=redis://:change-this-redis-password@redis:6379/2

# 生成方式：
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-secret-key-at-least-32-chars

# 生成方式：
# python3 -c "import secrets; print(secrets.token_hex(16))"
ENCRYPT_KEY=change-this-32-char-hex-encrypt-key

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
LOGIN_FAIL_MAX_TIMES=5
LOGIN_LOCK_MINUTES=30

# 改成你的正式域名
ALLOWED_ORIGINS=["https://your-domain.com"]

# ── AI / 向量 / 文件存储 ─────────────────────────────────────────
AI_DEFAULT_PROVIDER=openai
AI_DEFAULT_MODEL=gpt-3.5-turbo
ZHUILU_API_KEY=
ZHUILU_BASE_URL=https://api.zhuilu.ai/v1
ZHUILU_DEFAULT_MODEL=deepseek-chat
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OLLAMA_BASE_URL=http://localhost:11434

VECTOR_STORE_TYPE=pgvector
VECTOR_DIMENSION=1536
EMBEDDING_MODEL=text-embedding-3-small

STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY=
OSS_SECRET_KEY=
OSS_CDN_DOMAIN=
